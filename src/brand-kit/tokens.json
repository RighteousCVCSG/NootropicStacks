{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "NootropicStacker brand tokens v2 (Cognitive Lab). Source of truth (design intent) for the brand palette; src/brand-kit/tokens.css is the compiled-by-hand runtime mirror used by the browser. Dark-default palette: slate canvas + navy primary + electric cyan secondary. Consumable by style-dictionary, Tailwind config, or hand-rolled CSS pipeline.",
  "color": {
    "primary": {
      "900": { "$value": "#B8C7FF", "$type": "color", "$description": "Navy — softest tint, used for body links on dark." },
      "800": { "$value": "#5B8BFF", "$type": "color", "$description": "Navy — primary brand accent (CTAs, focused state)." },
      "700": { "$value": "#5B8BFF", "$type": "color", "$description": "Navy — primary action default." },
      "600": { "$value": "#5B8BFF", "$type": "color", "$description": "Navy — primary action default." },
      "500": { "$value": "#5B8BFF", "$type": "color", "$description": "Navy — primary brand accent." },
      "400": { "$value": "#5B8BFF", "$type": "color", "$description": "Navy — primary brand accent." },
      "300": { "$value": "#3B5BFF", "$type": "color", "$description": "Deeper navy — used as a richer primary in stack visualizations." },
      "100": { "$value": "#1F2A52", "$type": "color", "$description": "Navy midtone for raised primary surfaces in dark mode." },
      "050": { "$value": "#1A2547", "$type": "color", "$description": "Navy soft — primary-tinted background wash on dark." }
    },
    "accent": {
      "700": { "$value": "#0E8FA3", "$type": "color", "$description": "Deep cyan — accent rule on dark." },
      "600": { "$value": "#1AB6CC", "$type": "color", "$description": "Cyan hover state." },
      "500": { "$value": "#22D3EE", "$type": "color", "$description": "Electric cyan — secondary brand accent (synergy, positive signal)." },
      "300": { "$value": "#67E8F9", "$type": "color", "$description": "Cyan tint — hover/highlight on dark." },
      "100": { "$value": "#103847", "$type": "color", "$description": "Cyan midtone for raised secondary surfaces in dark mode." },
      "050": { "$value": "#0E3B47", "$type": "color", "$description": "Cyan soft — secondary-tinted background wash on dark." }
    },
    "surface": {
      "page": { "$value": "#0B0F1A", "$type": "color", "$description": "Default page background — deep slate canvas." },
      "card": { "$value": "#141926", "$type": "color", "$description": "Lifted card surface on the slate canvas." },
      "sunk": { "$value": "#1B2030", "$type": "color", "$description": "Raised surface (recessed/raised panels, code blocks)." },
      "ink":  { "$value": "#232940", "$type": "color", "$description": "Modal / overlay surface — highest in the dark stack." }
    },
    "ink": {
      "900": { "$value": "#FFFFFF", "$type": "color", "$description": "Primary text on dark canvas." },
      "700": { "$value": "#C8CDD9", "$type": "color", "$description": "Secondary text — muted body copy on dark." },
      "500": { "$value": "#8990A3", "$type": "color", "$description": "Tertiary / metadata. AA on slate canvas." },
      "400": { "$value": "#6F768A", "$type": "color", "$description": "Placeholders, disabled text on dark." },
      "300": { "$value": "#4F576B", "$type": "color", "$description": "Strong dividers / borders on dark." },
      "200": { "$value": "#2A3046", "$type": "color", "$description": "Default border color on dark canvas." },
      "100": { "$value": "#232940", "$type": "color", "$description": "Faint divider on dark canvas." },
      "050": { "$value": "#1B2030", "$type": "color", "$description": "Subtle hover wash on dark canvas." },
      "onDark": { "$value": "#FFFFFF", "$type": "color", "$description": "Text on saturated brand surfaces." }
    },
    "semantic": {
      "success": {
        "700": { "$value": "#0E8FA3", "$type": "color", "$description": "Cyan deep — positive/synergy strong (replaces green)." },
        "500": { "$value": "#22D3EE", "$type": "color", "$description": "Electric cyan — positive/synergy default." },
        "100": { "$value": "#0E3B47", "$type": "color", "$description": "Cyan soft — positive background tint on dark." }
      },
      "warn": {
        "700": { "$value": "#B88A1F", "$type": "color", "$description": "Deep amber — warning rule." },
        "500": { "$value": "#FFC53D", "$type": "color", "$description": "Functional warning — amber on dark." },
        "100": { "$value": "#3D2F12", "$type": "color", "$description": "Amber soft — warning background tint on dark." }
      },
      "danger": {
        "700": { "$value": "#B83A66", "$type": "color", "$description": "Deep magenta — danger rule." },
        "500": { "$value": "#FF5A8C", "$type": "color", "$description": "Functional danger — hot pink on dark, high contrast." },
        "100": { "$value": "#3D1A2A", "$type": "color", "$description": "Magenta soft — danger background tint on dark." }
      },
      "info": {
        "700": { "$value": "#3B5BFF", "$type": "color", "$description": "Deep navy — info rule." },
        "500": { "$value": "#5B8BFF", "$type": "color", "$description": "Navy — informational signal (matches primary)." },
        "100": { "$value": "#1A2547", "$type": "color", "$description": "Navy soft — info background tint on dark." }
      }
    },
    "tier": {
      "1": {
        "bg":   { "$value": "#1A2547", "$type": "color", "$description": "Tier 1 background — navy soft (authority)." },
        "fg":   { "$value": "#B8C7FF", "$type": "color", "$description": "Tier 1 foreground — navy tint." },
        "rule": { "$value": "#5B8BFF", "$type": "color", "$description": "Tier 1 rule — navy." }
      },
      "2": {
        "bg":   { "$value": "#0E3B47", "$type": "color", "$description": "Tier 2 background — cyan soft (measured)." },
        "fg":   { "$value": "#67E8F9", "$type": "color", "$description": "Tier 2 foreground — cyan tint." },
        "rule": { "$value": "#22D3EE", "$type": "color", "$description": "Tier 2 rule — electric cyan." }
      },
      "3": {
        "bg":   { "$value": "#3D2F12", "$type": "color", "$description": "Tier 3 background — amber soft (hedge)." },
        "fg":   { "$value": "#FFE082", "$type": "color", "$description": "Tier 3 foreground — light amber for legible labels." },
        "rule": { "$value": "#B88A1F", "$type": "color", "$description": "Tier 3 rule — deep amber, distinct from fg." }
      }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "Fraunces, 'Source Serif 4', Georgia, 'Times New Roman', serif", "$type": "fontFamily" },
      "body":    { "$value": "Inter, 'Helvetica Neue', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "xs":         { "$value": "0.75rem",  "$type": "dimension" },
      "sm":         { "$value": "0.875rem", "$type": "dimension" },
      "base":       { "$value": "1rem",     "$type": "dimension" },
      "md":         { "$value": "1.125rem", "$type": "dimension" },
      "lg":         { "$value": "1.25rem",  "$type": "dimension" },
      "xl":         { "$value": "1.5rem",   "$type": "dimension" },
      "displaySm":  { "$value": "2rem",     "$type": "dimension" },
      "displayMd":  { "$value": "2.5rem",   "$type": "dimension" },
      "displayLg":  { "$value": "3.5rem",   "$type": "dimension" },
      "displayXl":  { "$value": "4.5rem",   "$type": "dimension" }
    },
    "lineHeight": {
      "xs":        { "$value": 1.40 },
      "sm":        { "$value": 1.50 },
      "base":      { "$value": 1.625 },
      "md":        { "$value": 1.60 },
      "lg":        { "$value": 1.50 },
      "xl":        { "$value": 1.40 },
      "displaySm": { "$value": 1.20 },
      "displayMd": { "$value": 1.15 },
      "displayLg": { "$value": 1.05 },
      "displayXl": { "$value": 1.00 }
    },
    "tracking": {
      "tight":   { "$value": "-0.02em" },
      "snug":    { "$value": "-0.01em" },
      "normal":  { "$value": "0" },
      "wide":    { "$value": "0.04em" },
      "eyebrow": { "$value": "0.12em" }
    }
  },
  "space": {
    "0":  { "$value": "0",       "$type": "dimension" },
    "1":  { "$value": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "0.5rem",  "$type": "dimension" },
    "3":  { "$value": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "1rem",    "$type": "dimension" },
    "5":  { "$value": "1.5rem",  "$type": "dimension" },
    "6":  { "$value": "2rem",    "$type": "dimension" },
    "7":  { "$value": "3rem",    "$type": "dimension" },
    "8":  { "$value": "4rem",    "$type": "dimension" },
    "9":  { "$value": "6rem",    "$type": "dimension" },
    "10": { "$value": "8rem",    "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0",     "$type": "dimension" },
    "sm":   { "$value": "2px",   "$type": "dimension" },
    "md":   { "$value": "4px",   "$type": "dimension" },
    "lg":   { "$value": "8px",   "$type": "dimension" },
    "xl":   { "$value": "16px",  "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "shadow": {
    "1": { "$value": "0 1px 2px rgba(0,0,0,0.40)" },
    "2": { "$value": "0 4px 12px rgba(0,0,0,0.45)" },
    "3": { "$value": "0 12px 32px rgba(0,0,0,0.55)" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "standard":   { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "emphasized": { "$value": "cubic-bezier(0.3, 0, 0, 1)" }
    }
  },
  "measure": {
    "narrow": { "$value": "36rem", "$type": "dimension" },
    "base":   { "$value": "42rem", "$type": "dimension" },
    "wide":   { "$value": "60rem", "$type": "dimension" }
  },
  "theme": {
    "light": {
      "$description": "Light-mode overrides applied via :root[data-theme=\"light\"]. Only the color tokens that diverge from dark are listed; everything else (fonts, spacing, radius, motion, layout) is shared.",
      "color": {
        "surface": {
          "page": { "$value": "#FAFAFB", "$type": "color", "$description": "Light page background — near-white slate." },
          "card": { "$value": "#FFFFFF", "$type": "color", "$description": "Light lifted card surface." },
          "sunk": { "$value": "#F4F5F7", "$type": "color", "$description": "Light raised/recessed surface." },
          "ink":  { "$value": "#FFFFFF", "$type": "color", "$description": "Light modal/overlay surface." }
        },
        "ink": {
          "900": { "$value": "#0B0F1A", "$type": "color", "$description": "Primary text on light canvas." },
          "700": { "$value": "#404654", "$type": "color", "$description": "Secondary text on light." },
          "500": { "$value": "#5B6478", "$type": "color", "$description": "Tertiary/metadata. ≥4.5:1 on #FAFAFB." },
          "400": { "$value": "#8C95A8", "$type": "color", "$description": "Placeholders, disabled text on light." },
          "300": { "$value": "#B8BFCC", "$type": "color", "$description": "Strong dividers on light." },
          "200": { "$value": "#E5E7EB", "$type": "color", "$description": "Default border on light." },
          "100": { "$value": "#EEF0F4", "$type": "color", "$description": "Faint divider on light." },
          "050": { "$value": "#F4F5F7", "$type": "color", "$description": "Subtle hover wash on light." }
        },
        "primary": {
          "800": { "$value": "#1D4ED8", "$type": "color", "$description": "Light-mode primary action — deeper navy for contrast." },
          "500": { "$value": "#2563EB", "$type": "color", "$description": "Light-mode primary brand accent." },
          "100": { "$value": "#DBEAFE", "$type": "color", "$description": "Navy midtone for raised primary surfaces in light mode." },
          "050": { "$value": "#EFF6FF", "$type": "color", "$description": "Navy soft — primary background wash on light." }
        },
        "accent": {
          "700": { "$value": "#155E75", "$type": "color", "$description": "Deep cyan rule on light." },
          "500": { "$value": "#0891B2", "$type": "color", "$description": "Light-mode secondary brand accent." },
          "050": { "$value": "#CFFAFE", "$type": "color", "$description": "Cyan soft — secondary wash on light." }
        },
        "semantic": {
          "warn":   { "500": { "$value": "#D97706", "$type": "color" } },
          "danger": { "500": { "$value": "#E11D48", "$type": "color" } }
        },
        "tier": {
          "1": {
            "bg":   { "$value": "#EFF6FF", "$type": "color" },
            "fg":   { "$value": "#1E3A8A", "$type": "color" },
            "rule": { "$value": "#2563EB", "$type": "color" }
          },
          "2": {
            "bg":   { "$value": "#CFFAFE", "$type": "color" },
            "fg":   { "$value": "#155E75", "$type": "color" },
            "rule": { "$value": "#0891B2", "$type": "color" }
          },
          "3": {
            "bg":   { "$value": "#FEF3C7", "$type": "color" },
            "fg":   { "$value": "#92400E", "$type": "color" },
            "rule": { "$value": "#D97706", "$type": "color" }
          }
        }
      }
    }
  }
}
