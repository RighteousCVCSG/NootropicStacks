{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "NootropicStacker brand tokens v1. Mirror of brand-kit/tokens/tokens.css. Consumable by style-dictionary, Tailwind config, or hand-rolled CSS pipeline.",
  "color": {
    "primary": {
      "900": { "$value": "#0a3733", "$type": "color" },
      "800": { "$value": "#0f4c46", "$type": "color", "$description": "Primary action default. Links. Tier-1 stamp." },
      "700": { "$value": "#166259", "$type": "color", "$description": "Hover for primary." },
      "600": { "$value": "#2c7a70", "$type": "color" },
      "500": { "$value": "#4a958b", "$type": "color" },
      "300": { "$value": "#9bc2bb", "$type": "color" },
      "100": { "$value": "#d8e8e5", "$type": "color" },
      "050": { "$value": "#eef5f3", "$type": "color" }
    },
    "accent": {
      "700": { "$value": "#8a5a14", "$type": "color" },
      "600": { "$value": "#a8701a", "$type": "color" },
      "500": { "$value": "#c9831f", "$type": "color", "$description": "Editorial accent. Hedge cue. NOT a CTA color." },
      "300": { "$value": "#e3b478", "$type": "color" },
      "100": { "$value": "#f4e2c4", "$type": "color" },
      "050": { "$value": "#fbf3e3", "$type": "color" }
    },
    "surface": {
      "page": { "$value": "#faf7f2", "$type": "color", "$description": "Default page background. Warm cream." },
      "card": { "$value": "#ffffff", "$type": "color" },
      "sunk": { "$value": "#f3eee5", "$type": "color" },
      "ink":  { "$value": "#1a1714", "$type": "color", "$description": "Dark surface for footers, hero overlays." }
    },
    "ink": {
      "900": { "$value": "#1a1714", "$type": "color", "$description": "Body text on light." },
      "700": { "$value": "#3d3833", "$type": "color" },
      "500": { "$value": "#6e6862", "$type": "color", "$description": "Tertiary / metadata. AA on cream." },
      "400": { "$value": "#8c857d", "$type": "color" },
      "300": { "$value": "#b8b0a6", "$type": "color" },
      "200": { "$value": "#d6cfc4", "$type": "color" },
      "100": { "$value": "#e5dfd6", "$type": "color" },
      "050": { "$value": "#f0ebe3", "$type": "color" },
      "onDark": { "$value": "#faf7f2", "$type": "color" }
    },
    "semantic": {
      "success": {
        "700": { "$value": "#1f5d42", "$type": "color" },
        "500": { "$value": "#2e7d5b", "$type": "color" },
        "100": { "$value": "#d8ece1", "$type": "color" }
      },
      "warn": {
        "700": { "$value": "#8a5510", "$type": "color" },
        "500": { "$value": "#a86a11", "$type": "color" },
        "100": { "$value": "#f4e2c4", "$type": "color" }
      },
      "danger": {
        "700": { "$value": "#862930", "$type": "color" },
        "500": { "$value": "#a6353a", "$type": "color" },
        "100": { "$value": "#f1d4d6", "$type": "color" }
      },
      "info": {
        "700": { "$value": "#1d4f74", "$type": "color" },
        "500": { "$value": "#2a6b96", "$type": "color" },
        "100": { "$value": "#d1e3ef", "$type": "color" }
      }
    },
    "tier": {
      "1": {
        "bg":   { "$value": "#d8e8e5", "$type": "color" },
        "fg":   { "$value": "#0a3733", "$type": "color" },
        "rule": { "$value": "#166259", "$type": "color" }
      },
      "2": {
        "bg":   { "$value": "#e2dccc", "$type": "color" },
        "fg":   { "$value": "#3d3833", "$type": "color" },
        "rule": { "$value": "#6e6862", "$type": "color" }
      },
      "3": {
        "bg":   { "$value": "#f4e2c4", "$type": "color" },
        "fg":   { "$value": "#8a5510", "$type": "color" },
        "rule": { "$value": "#c9831f", "$type": "color" }
      }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "Fraunces, 'Source Serif 4', Georgia, 'Times New Roman', serif", "$type": "fontFamily" },
      "body":    { "$value": "Inter, 'Helvetica Neue', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "xs":         { "$value": "0.75rem",  "$type": "dimension" },
      "sm":         { "$value": "0.875rem", "$type": "dimension" },
      "base":       { "$value": "1rem",     "$type": "dimension" },
      "md":         { "$value": "1.125rem", "$type": "dimension" },
      "lg":         { "$value": "1.25rem",  "$type": "dimension" },
      "xl":         { "$value": "1.5rem",   "$type": "dimension" },
      "displaySm":  { "$value": "2rem",     "$type": "dimension" },
      "displayMd":  { "$value": "2.5rem",   "$type": "dimension" },
      "displayLg":  { "$value": "3.5rem",   "$type": "dimension" },
      "displayXl":  { "$value": "4.5rem",   "$type": "dimension" }
    },
    "lineHeight": {
      "xs":        { "$value": 1.40 },
      "sm":        { "$value": 1.50 },
      "base":      { "$value": 1.625 },
      "md":        { "$value": 1.60 },
      "lg":        { "$value": 1.50 },
      "xl":        { "$value": 1.40 },
      "displaySm": { "$value": 1.20 },
      "displayMd": { "$value": 1.15 },
      "displayLg": { "$value": 1.05 },
      "displayXl": { "$value": 1.00 }
    },
    "tracking": {
      "tight":   { "$value": "-0.02em" },
      "snug":    { "$value": "-0.01em" },
      "normal":  { "$value": "0" },
      "wide":    { "$value": "0.04em" },
      "eyebrow": { "$value": "0.12em" }
    }
  },
  "space": {
    "0":  { "$value": "0",       "$type": "dimension" },
    "1":  { "$value": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "0.5rem",  "$type": "dimension" },
    "3":  { "$value": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "1rem",    "$type": "dimension" },
    "5":  { "$value": "1.5rem",  "$type": "dimension" },
    "6":  { "$value": "2rem",    "$type": "dimension" },
    "7":  { "$value": "3rem",    "$type": "dimension" },
    "8":  { "$value": "4rem",    "$type": "dimension" },
    "9":  { "$value": "6rem",    "$type": "dimension" },
    "10": { "$value": "8rem",    "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0",     "$type": "dimension" },
    "sm":   { "$value": "2px",   "$type": "dimension" },
    "md":   { "$value": "4px",   "$type": "dimension" },
    "lg":   { "$value": "8px",   "$type": "dimension" },
    "xl":   { "$value": "16px",  "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "shadow": {
    "1": { "$value": "0 1px 2px rgba(26,23,20,0.08)" },
    "2": { "$value": "0 4px 12px rgba(26,23,20,0.10)" },
    "3": { "$value": "0 12px 32px rgba(26,23,20,0.12)" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "standard":   { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "emphasized": { "$value": "cubic-bezier(0.3, 0, 0, 1)" }
    }
  },
  "measure": {
    "narrow": { "$value": "36rem", "$type": "dimension" },
    "base":   { "$value": "42rem", "$type": "dimension" },
    "wide":   { "$value": "60rem", "$type": "dimension" }
  }
}
