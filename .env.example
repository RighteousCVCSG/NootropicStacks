# NootropicStacker.com Environment Variables
# Copy this to .env and fill in real values

# MySQL Database (Railway)
DATABASE_URL=mysql://root:PASSWORD@crossover.proxy.rlwy.net:52291/railway

# OAuth Login (set when ready to enable premium tier)
VITE_OAUTH_PORTAL_URL=placeholder
VITE_APP_ID=placeholder

# ── Beehiiv Newsletter Integration ────────────────────────────
# Email capture forms POST to /api/email/subscribe (server.js).
# When Beehiiv keys are set, subscriptions go to Beehiiv with
# MySQL as a backup. Without keys, emails store in MySQL only
# (lead magnet PDF links still work).
#
# Get credentials from: https://app.beehiiv.com/settings/integrations/api
#
# 1. Create a publication in Beehiiv
# 2. Generate an API key (Settings > Integrations > API)
# 3. Set both vars below (uncomment)
# 4. Restart server to activate
#
# BEEHIIV_API_KEY=bh_xxxxxxxxxxxx
# BEEHIIV_PUBLICATION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BEEHIIV_DOUBLE_OPT_IN=true
# BEEHIIV_API_BASE=https://api.beehiiv.com/v2

# These are set automatically by Railway in production:
# PORT=8000
# NODE_ENV=production
